{
    "name": "zoid",
    "version": "11.0.0",
    "description": "Cross-domain components: render an iframe or popup on another domain, pass it props including functions, and call back natively.",
    "keywords": [
        "cross-domain",
        "cross domain",
        "components",
        "component",
        "iframe",
        "popup",
        "postmessage",
        "cugel"
    ],
    "homepage": "https://github.com/bluepnume/zoid#readme",
    "bugs": {
        "url": "https://github.com/bluepnume/zoid/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bluepnume/zoid.git"
    },
    "license": "Apache-2.0",
    "author": "Daniel Brain",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cugel-scripts build",
        "fix": "cugel-scripts fix --changed",
        "fix:all": "cugel-scripts fix",
        "imports:missing": "cugel-scripts imports:missing --changed",
        "lint": "cugel-scripts lint",
        "test:static": "cugel-scripts static",
        "test:unit": "cugel-scripts test --coverage",
        "test:watch": "cugel-scripts test --watch",
        "test": "npm run test:static && npm run build && npm run test:unit",
        "prepack": "npm run build"
    },
    "dependencies": {
        "belter": "^3.0.0",
        "cross-domain-utils": "^4.0.2",
        "post-robot": "^12.2.0",
        "zalgo-promise": "^3.0.1"
    },
    "devDependencies": {
        "@vitest/coverage-istanbul": "^5.0.5",
        "cugel-scripts": "^0.1.0",
        "esbuild": "^0.28.0"
    }
}
